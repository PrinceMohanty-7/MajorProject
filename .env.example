# Use a long random value and keep it private in production.
SCAMSHIELD_JWT_SECRET=replace-with-a-long-random-secret
# Set APP_ENV=production to refuse startup without the JWT secret.

# Local SQLite is the default. Example Supabase/PostgreSQL URL:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/postgres

# Optional OpenAI-compatible chat-completions provider.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
